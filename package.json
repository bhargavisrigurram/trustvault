{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure document-sharing platform with central authorization, server-side sessions, and audit verification",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node --max-old-space-size=384 apps/api/dist/server.js",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "migrate": "tsx database/migrate.ts",
    "seed": "tsx database/seed.ts",
    "mutation-test": "tsx scripts/mutation-test.ts"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.4",
    "multer": "^2.5.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.1"
  }
}
